# Server-only settings for the design assistant (copy to .env.local). Never prefix these with VITE_.
# Designers pick the provider and model in the assistant panel; a provider without a key here is
# answered by the built-in rules (with a notice) unless ASSISTANT_FALLBACK_TO_RULES=off.
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted instead of GEMINI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Default when a request names no provider: gemini (default), anthropic, openai or rules.
# ASSISTANT_PROVIDER=gemini
# ASSISTANT_MODEL=gemini-3.8-flash   # must be one of the provider's listed models
# ASSISTANT_FALLBACK_TO_RULES=on
# ASSISTANT_EFFORT=medium            # Anthropic and OpenAI reasoning effort
# ASSISTANT_TIMEOUT_MS=45000
# ASSISTANT_RATE_LIMIT=30
