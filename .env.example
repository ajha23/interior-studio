# Server-only settings for the design assistant (copy to .env.local). Never prefix these with VITE_.
# Without them, /api/assistant uses the deterministic rule-based provider.
ASSISTANT_PROVIDER=rules
# ASSISTANT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_TIMEOUT_MS=45000
# ASSISTANT_RATE_LIMIT=30
